<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>smart-flow-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>smart-flow-parent</name>
    <description>多节点对话工作流 Base：框架（core / web）+ 示例工作流（demo）</description>

    <modules>
        <!-- 框架：引擎、节点基类、路由、记忆、trace、数据访问。新工作流依赖它 -->
        <module>smart-flow-core</module>
        <!-- 框架：SSE 对话接口、调试接口、测试页面。需要 HTTP 接口时依赖它 -->
        <module>smart-flow-web</module>
        <!-- 示例：智慧民生工作流，可直接运行；新工作流可以照着它写 -->
        <module>smart-flow-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- LangGraph4j 1.8.x 是 LTS 线；1.8.27 构建时使用的 LangChain4j 是 1.19.0，这里保持一致 -->
        <langgraph4j.version>1.8.27</langgraph4j.version>
        <langchain4j.version>1.19.0</langchain4j.version>
        <!-- 3.0.5 的基线是 Spring Boot 3.5.x；4.x 是给 Spring Boot 4 用的 -->
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>smart-flow-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>smart-flow-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-core</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
